# Variável obrigatória: chave secreta para assinatura de JWT tokens.
# Gere uma chave forte com: openssl rand -base64 48
# NUNCA use valores previsíveis ou genéricos.
JWT_SECRET=sua_chave_secreta_aqui_mude_isto

# URL de conexão com PostgreSQL.
# Exemplo Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/brinquedoteca?sslmode=require
# Exemplo Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/brinquedoteca
